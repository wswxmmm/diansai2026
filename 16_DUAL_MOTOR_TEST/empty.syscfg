I2C1.$name                       = "I2C";
I2C1.basicEnableController       = true;
I2C1.basicControllerBusSpeed     = 400000;
I2C1.advAnalogGlitchFilter       = "DISABLED";
I2C1.peripheral.$assign          = "I2C1";
I2C1.peripheral.sclPin.$assign   = "PB2";
I2C1.peripheral.sdaPin.$assign   = "PB3";

MPUI2C.$name                       = "MPU_I2C";
MPUI2C.basicEnableController       = true;
MPUI2C.basicControllerBusSpeed     = 100000;
MPUI2C.advAnalogGlitchFilter       = "DISABLED";
MPUI2C.peripheral.$assign          = "I2C0";
MPUI2C.peripheral.sclPin.$assign   = "PA1";
MPUI2C.peripheral.sdaPin.$assign   = "PA0";

PWM0.$name                      = "PWM_0";
PWM0.clockPrescale              = 256;
PWM0.timerCount                 = 1000;
PWM0.pwmMode                    = "EDGE_ALIGN";
PWM0.peripheral.$assign         = "TIMA1";
