GRAYADDR.$name                         = "GRAY_ADDRESS";
GRAYADDR.associatedPins.create(3);
GRAYADDR.associatedPins[0].$name       = "AD0";
GRAYADDR.associatedPins[0].pin.$assign = "PB0";
GRAYADDR.associatedPins[1].$name       = "AD1";
GRAYADDR.associatedPins[1].pin.$assign = "PB1";
GRAYADDR.associatedPins[2].$name       = "AD2";
