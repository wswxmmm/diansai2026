GRAYADC.$name                      = "GRAY_ADC";
GRAYADC.sampClkSrc                 = "DL_ADC12_CLOCK_ULPCLK";
GRAYADC.sampClkDiv                 = "DL_ADC12_CLOCK_DIVIDE_8";
GRAYADC.adcMem0chansel             = "DL_ADC12_INPUT_CHAN_0";
